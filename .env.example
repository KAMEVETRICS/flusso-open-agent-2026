# Meterless Nightshift: the primary AI provider (Meterless Runtime 0.90, OpenAI-compatible).
# Copy the runtime token from Nightshift's Console. The NVIDIA API key goes in Nightshift's
# Providers tab, never in this file.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
# Optional: a different routing mode or model for the evidence agent (defaults to METERLESS_MODEL).
METERLESS_AGENT_MODEL=

# Zetaris: the agent's data layer (local Lightning instance in Docker).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Runtime behaviour. SAMPLE_MODE=true replays the recorded runs in samples/ with no Zetaris,
# Nightshift, or network access.
SAMPLE_MODE=false

# OpenRouter: fallback text provider when Nightshift is not configured, and the image model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_TIMEOUT_MS=300000
OPENROUTER_IMAGE_TIMEOUT_MS=180000
# Evidence agent model on OpenRouter (defaults to nvidia/nemotron-3-ultra-550b-a55b).
FLUSSO_AGENT_MODEL=

# Firecrawl reads the brand website, its key pages, competitor search results, and claim evidence.
FIRECRAWL_API_KEY=

# Neon pooled connection string
DATABASE_URL=
